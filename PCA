## -----------------------------------------------------------------------------
## 4.4 PCA QC plot after protein-coding filtering
## -----------------------------------------------------------------------------
library(DESeq2)
library(ggplot2)
library(dplyr)
library(ggrepel)
## -----------------------------------------------------------------------------
## Variance stabilizing transformation and PCA / PCA plot
## -----------------------------------------------------------------------------

#rlog.risk <- rlog(dds.risk, blind = TRUE)
vsd.risk <- vst(dds.risk, blind = TRUE)

pca.risk <- plotPCA(
  vsd.risk,
  intgroup = c("Treatment"),
  ntop = 1000,
  returnData = TRUE
)

percentVar.risk <- round(100 * attr(pca.risk, "percentVar"))

pca.risk$SampleID <- rownames(pca.risk)

risk_pca_plot <- ggplot(
  pca.risk,
  aes(x = PC1, y = PC2, color = Treatment, label = SampleID)
) +
  geom_point(size = 4) +
  ggrepel::geom_text_repel(
    size = 3,
    max.overlaps = Inf
  ) +
  scale_color_manual(
    values = c(
      "Vehicle" = "grey40",
      "RETA" = "red",
      "WM" = "blue"
    )
  ) +
  labs(
    title = "Risk study PCA",
    x = paste0("PC1: ", percentVar.risk[1], "% variance"),
    y = paste0("PC2: ", percentVar.risk[2], "% variance"),
    color = "Treatment"
  ) +
  theme_bw() +
  theme(
    plot.title = element_text(face = "plain", hjust = 0.5),
    legend.position = "right"
  )

risk_pca_plot

save_plot(risk_pca_plot, "Risk_PCA_vst_after_protein_coding_filter")


## -----------------------------------------------------------------------------
## Label only potential outliers
## -----------------------------------------------------------------------------

pca.risk <- pca.risk %>%
  dplyr::mutate(
    Label = ifelse(
      abs(scale(PC1)) > 2 | abs(scale(PC2)) > 2,
      SampleID,
      NA
    )
  )

risk_pca_plot_outlier_label <- ggplot(
  pca.risk,
  aes(x = PC1, y = PC2, color = Treatment, label = Label)
) +
  geom_point(size = 4) +
  ggrepel::geom_text_repel(
    size = 3,
    na.rm = TRUE,
    max.overlaps = Inf
  ) +
  scale_color_manual(
    values = c(
      "Vehicle" = "grey40",
      "RETA" = "red",
      "WM" = "blue"
    )
  ) +
  labs(
    title = "Risk study PCA",
    x = paste0("PC1: ", percentVar.risk[1], "% variance"),
    y = paste0("PC2: ", percentVar.risk[2], "% variance"),
    color = "Treatment"
  ) +
  theme_bw() +
  theme(
    plot.title = element_text(face = "plain", hjust = 0.5),
    legend.position = "right"
  )

risk_pca_plot_outlier_label

save_plot(risk_pca_plot_outlier_label, "Risk_PCA_vst_outlier_label")

## -----------------------------------------------------------------------------
## Extract PCA manually to visualize PC1, PC2, and PC3 and add metadata
## -----------------------------------------------------------------------------

pca_mat.risk <- assay(vsd.risk)

pca_res.risk <- prcomp(t(pca_mat.risk))

pca_df.risk <- as.data.frame(pca_res.risk$x[, 1:3])
pca_df.risk$SampleID <- rownames(pca_df.risk)

meta.risk <- as.data.frame(colData(dds.risk)) %>%
  dplyr::select(SampleID, Treatment, Tissue, Cohort)

pca_df.risk <- pca_df.risk %>%
  dplyr::left_join(
    meta.risk,
    by = "SampleID"
  )

percentVar.manual.risk <- round(
  100 * (pca_res.risk$sdev^2 / sum(pca_res.risk$sdev^2))
)

colnames(pca_df.risk)
head(pca_df.risk)

risk_pca_PC1_PC3_plot <- ggplot(
  pca_df.risk,
  aes(x = PC1, y = PC3, color = Treatment, label = SampleID)
) +
  geom_point(size = 4) +
  ggrepel::geom_text_repel(
    size = 3,
    max.overlaps = Inf
  ) +
  scale_color_manual(
    values = c(
      "Vehicle" = "grey40",
      "RETA" = "red",
      "WM" = "blue"
    )
  ) +
  labs(
    title = "Risk study PCA: PC1 vs PC3",
    x = paste0("PC1: ", percentVar.manual.risk[1], "% variance"),
    y = paste0("PC3: ", percentVar.manual.risk[3], "% variance"),
    color = "Treatment"
  ) +
  theme_bw() +
  theme(
    plot.title = element_text(face = "plain", hjust = 0.5),
    legend.position = "right"
  )

risk_pca_PC1_PC3_plot

save_plot(risk_pca_PC1_PC3_plot, "Risk_PCA_vst_PC1_PC3")

